# Backend (copy to backend/.env)
DATABASE_URL=sqlite:///./.runtime.db
SECRET_KEY=continuityos-dev-secret-key-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
ENVIRONMENT=development

# Optional LLM extraction (leave blank to use the explicit rule-based fallback)
LLM_PROVIDER=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620